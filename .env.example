# 前端与后端对外访问端口，可按需修改。
BOBO_WEB_PORT=5170
BOBO_API_PORT=5171

# Flutter Web 构建时写入的正式服务根地址；客户端会自动补齐 api/v1/。
BOBO_PUBLIC_API_BASE_URL=https://wx.jiayuntong.com:5172/server/

# 必须指向已经存在的宿主机目录；Windows 也可填写绝对路径。
BOBO_MEDIA_HOST_PATH=./Service/media

# 已转码的 HLS/CMAF 正式资产目录，可直接在宿主机查看和备份。
BOBO_HLS_HOST_PATH=./Service/hls-cache

# Android 升级清单与 APK 目录，必须已经存在，并以只读方式挂载到 Service。
BOBO_UPDATE_HOST_PATH=./Service/updates

# 百度 OAuth 令牌宿主机目录，必须存在且可由 Service 的非 root 用户写入。
BOBO_BAIDU_AUTH_HOST_PATH=./Service/baidu-auth

# 完成设备码授权并生成 token.json 后再启用；API 根路径不要包含“我的网盘”。
BOBO_BAIDU_ENABLED=false
BOBO_BAIDU_ROOT_PATH=/菠萝乐园
BOBO_BAIDU_CACHE_SECS=60

# 缺少人工封面时，从视频第几秒截取自动封面；短视频会自动回退到首帧。
BOBO_COVER_CAPTURE_SECS=3

# 百度网盘开放平台应用凭证；请仅在本地 .env 中填写真实值。
BAIDU_NETDISK_APP_ID=
BAIDU_NETDISK_APP_KEY=
BAIDU_NETDISK_SECRET_KEY=
BAIDU_NETDISK_SIGN_KEY=
